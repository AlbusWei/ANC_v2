{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anc-v2.local/schemas/llm_judge_input.schema.json",
  "title": "ANC LLM Judge Input v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "objective",
    "spec_ref",
    "expected_conditions",
    "actual_output_ref",
    "test_case_ref",
    "evaluation_mode",
    "backend",
    "timeout_seconds",
    "evidence_root"
  ],
  "properties": {
    "objective": {
      "type": "string",
      "minLength": 1
    },
    "spec_ref": {
      "type": "string",
      "minLength": 1
    },
    "expected_conditions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "actual_output_ref": {
      "type": "string",
      "minLength": 1
    },
    "test_case_ref": {
      "type": "string",
      "minLength": 1
    },
    "evaluation_mode": {
      "type": "string",
      "enum": [
        "objective",
        "subjective_ab"
      ]
    },
    "backend": {
      "type": "string",
      "const": "scenario_python"
    },
    "timeout_seconds": {
      "type": "integer",
      "minimum": 1
    },
    "evidence_root": {
      "type": "string",
      "minLength": 1
    },
    "subjective_config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "rounds": {
          "type": "integer",
          "minimum": 1,
          "default": 9
        },
        "perspectives": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "thresholds": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "accept": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.67
            },
            "reject": {
              "type": "number",
              "minimum": 0,
              "maximum": 1,
              "default": 0.5
            }
          }
        }
      }
    },
    "scenario_overrides": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "max_turns": {
          "type": "integer",
          "minimum": 1
        },
        "cache_key": {
          "type": "string"
        },
        "set_id": {
          "type": "string"
        }
      }
    }
  }
}
