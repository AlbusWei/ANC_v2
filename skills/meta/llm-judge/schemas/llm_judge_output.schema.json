{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anc-v2.local/schemas/llm_judge_output.schema.json",
  "title": "ANC LLM Judge Output v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "pass",
    "confidence",
    "remarks",
    "suggestions",
    "evidence_refs",
    "judge_backend",
    "fail_closed",
    "fail_closed_reason"
  ],
  "properties": {
    "pass": {
      "type": "boolean"
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "remarks": {
      "type": "string"
    },
    "suggestions": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "evidence_refs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "judge_backend": {
      "type": "string",
      "const": "scenario_python"
    },
    "fail_closed": {
      "type": "boolean"
    },
    "fail_closed_reason": {
      "type": "string"
    }
  }
}
