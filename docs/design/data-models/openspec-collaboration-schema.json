{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "docs/design/data-models/openspec-collaboration-schema.json",
  "title": "OpenSpec Collaboration Sync Record",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "record_id",
    "round_goal",
    "module_scope",
    "owner",
    "openspec_ref",
    "anc_design_refs",
    "decision_snapshot_ref",
    "sync_status",
    "sync_timestamp",
    "sync_actor",
    "trigger_mode",
    "inspection_profile",
    "risk_level",
    "conflict_state",
    "evidence_bundle",
    "sync_actions"
  ],
  "properties": {
    "record_id": {
      "type": "string",
      "pattern": "^osc-[a-z0-9-]+$"
    },
    "round_goal": {
      "type": "string",
      "minLength": 1
    },
    "module_scope": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^M[1-6]$"
      }
    },
    "owner": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "openspec_ref": {
      "type": "string",
      "minLength": 1
    },
    "anc_design_refs": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
      }
    },
    "decision_snapshot_ref": {
      "type": "string",
      "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+"
    },
    "sync_status": {
      "type": "string",
      "enum": [
        "in_sync",
        "needs_sync",
        "conflict",
        "blocked"
      ]
    },
    "sync_timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "sync_actor": {
      "type": "string",
      "pattern": "^[a-z0-9-]+$"
    },
    "trigger_mode": {
      "type": "string",
      "enum": [
        "change_triggered",
        "analyst_inspection"
      ]
    },
    "inspection_profile": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "cadence_mode",
        "cadence_hint",
        "primary_signal"
      ],
      "properties": {
        "cadence_mode": {
          "type": "string",
          "enum": [
            "adaptive",
            "fixed"
          ]
        },
        "cadence_hint": {
          "type": "string",
          "minLength": 1
        },
        "primary_signal": {
          "type": "string",
          "enum": [
            "change_density",
            "risk_level",
            "open_questions"
          ]
        }
      }
    },
    "risk_level": {
      "type": "string",
      "enum": [
        "low",
        "medium",
        "high",
        "critical"
      ]
    },
    "conflict_state": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "has_conflict",
        "resolved",
        "resolution_ref"
      ],
      "properties": {
        "has_conflict": {
          "type": "boolean"
        },
        "resolved": {
          "type": "boolean"
        },
        "resolution_ref": {
          "type": "string"
        }
      }
    },
    "evidence_bundle": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "openspec_linkage_ref",
        "anc_delta_index_ref",
        "sync_check_report_ref",
        "status_report_ref"
      ],
      "properties": {
        "openspec_linkage_ref": {
          "type": "string",
          "minLength": 1
        },
        "anc_delta_index_ref": {
          "type": "string"
        },
        "sync_check_report_ref": {
          "type": "string",
          "minLength": 1
        },
        "status_report_ref": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sync_actions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "action",
          "result"
        ],
        "properties": {
          "action": {
            "type": "string",
            "minLength": 1
          },
          "result": {
            "type": "string",
            "enum": [
              "ok",
              "failed",
              "skipped"
            ]
          }
        }
      }
    }
  }
}
