{
  "process_id": "trigger-event-runtime",
  "version": "0.3.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m2-trigger-governance-runtime",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "event_id",
      "event_time",
      "entity_type",
      "entity_id",
      "from_status",
      "to_status",
      "evidence_ref",
      "match_policy_ref",
      "dedupe_policy_ref",
      "catchup_policy_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "trigger_receipt_ref",
      "dedupe_decision",
      "runtime_trace_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "normalize-event-ingress",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "inline-ap:trigger-event-runtime:p1",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-026-trigger-ingress-normalization.md#ap-026-trigger-ingress-normalization",
      "sipoc": {
        "supplier": "initiator",
        "input": "event payload",
        "process": "normalize event into canonical envelope",
        "output": "canonical_trigger_ref",
        "client": "p2"
      },
      "acceptance_criteria": "event fields satisfy minimal canonical contract",
      "inline_ap": {
        "ap_id": "inline-ap:trigger-event-runtime:p1",
        "skill_id": "sys.bpm.trigger-ingress-normalizer",
        "actor": "bpm",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "将事件输入归一为统一触发包，保证后续判定基于同一语义平面。",
      "input_context_ref": "event payload",
      "done_definition": "必须产出 canonical_trigger_ref，且事件关键字段齐全。",
      "handoff_note": "将 canonical_trigger_ref 交接给 p2。"
    },
    {
      "phase_id": "p2",
      "name": "match-and-dedupe",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "inline-ap:trigger-event-runtime:p2",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-027-trigger-match-and-dedupe.md#ap-027-trigger-match-and-dedupe",
      "sipoc": {
        "supplier": "p1",
        "input": "canonical_trigger_ref",
        "process": "match target process and dedupe event",
        "output": "dedupe_decision",
        "client": "p3"
      },
      "acceptance_criteria": "dedupe decision is deterministic and traceable",
      "inline_ap": {
        "ap_id": "inline-ap:trigger-event-runtime:p2",
        "skill_id": "sys.bpm.trigger-matcher-dedupe",
        "actor": "bpm",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "执行事件匹配与去重，拦截重复或无效事件进入实例层。",
      "input_context_ref": "canonical_trigger_ref",
      "done_definition": "必须产出 dedupe_decision，并可追溯匹配依据。",
      "handoff_note": "将 dedupe_decision 交接给 p3（或按拒绝分支流向 p4）。"
    },
    {
      "phase_id": "p3",
      "name": "dispatch-instance",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "inline-ap:trigger-event-runtime:p3",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-028-trigger-dispatch-and-instance-start.md#ap-028-trigger-dispatch-and-instance-start",
      "sipoc": {
        "supplier": "p2",
        "input": "dedupe_decision",
        "process": "create runtime instance on matched events",
        "output": "instance_id",
        "client": "p4"
      },
      "acceptance_criteria": "event hit results in exactly one instance",
      "inline_ap": {
        "ap_id": "inline-ap:trigger-event-runtime:p3",
        "skill_id": "sys.bpm.process-instance-manager",
        "actor": "bpm",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "为命中事件启动流程实例，将事件治理结果转为执行动作。",
      "input_context_ref": "dedupe_decision",
      "done_definition": "必须产出 instance_id，且事件命中仅对应单实例。",
      "handoff_note": "将 instance_id 交接给 p4。"
    },
    {
      "phase_id": "p4",
      "name": "record-trigger-evidence",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "inline-ap:trigger-event-runtime:p4",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-029-trigger-evidence-recording.md#ap-029-trigger-evidence-recording",
      "sipoc": {
        "supplier": "p3",
        "input": "instance_id",
        "process": "persist trigger receipt and traceability links",
        "output": "trigger_receipt_ref",
        "client": "p5"
      },
      "acceptance_criteria": "trigger receipt includes dedupe and dispatch decisions",
      "inline_ap": {
        "ap_id": "inline-ap:trigger-event-runtime:p4",
        "skill_id": "sys.bpm.evidence-recorder",
        "actor": "bpm",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "记录事件触发回执与证据链，保障事件到实例的可审计性。",
      "input_context_ref": "instance_id",
      "done_definition": "必须产出 trigger_receipt_ref，包含去重与分发决策。",
      "handoff_note": "将 trigger_receipt_ref 交接给 p5。"
    },
    {
      "phase_id": "p5",
      "name": "request-backfill-or-catchup",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "inline-ap:trigger-event-runtime:p5",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-030-trigger-catchup-scheduling.md#ap-030-trigger-catchup-scheduling",
      "sipoc": {
        "supplier": "p4",
        "input": "trigger_receipt_ref",
        "process": "issue backfill or dynamic catchup decision when evidence is incomplete",
        "output": "catchup_decision",
        "client": "p6"
      },
      "acceptance_criteria": "missing evidence produces explicit backfill or escalation hint",
      "inline_ap": {
        "ap_id": "inline-ap:trigger-event-runtime:p5",
        "skill_id": "sys.bpm.catchup-scheduler",
        "actor": "bpm",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "对证据不足场景给出补数或补跑判断，避免缺证据直接放行。",
      "input_context_ref": "trigger_receipt_ref",
      "done_definition": "必须产出 catchup_decision，并附带可解释原因。",
      "handoff_note": "将 catchup_decision 交接给 p6 或直接结束。"
    },
    {
      "phase_id": "p6",
      "name": "escalate-runtime-anomaly",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "inline-ap:trigger-event-runtime:p6",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-031-trigger-escalation-handling.md#ap-031-trigger-escalation-handling",
      "sipoc": {
        "supplier": "p5",
        "input": "catchup_decision",
        "process": "escalate unresolved event-runtime anomaly",
        "output": "escalation_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "escalation chain is complete and auditable",
      "inline_ap": {
        "ap_id": "inline-ap:trigger-event-runtime:p6",
        "skill_id": "sys.bpm.escalation-handler",
        "actor": "bpm",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "对事件运行异常执行升级链收口，确保流程可终止可追责。",
      "input_context_ref": "catchup_decision",
      "done_definition": "必须产出 escalation_ref，并满足升级链可审计。",
      "handoff_note": "将 escalation_ref 交接给 initiator。"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success",
      "condition": "dedupe_decision == allow"
    },
    {
      "from": "p2",
      "to": "p4",
      "on": "success",
      "condition": "dedupe_decision == reject"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "end",
      "on": "success",
      "condition": "catchup_decision == run || catchup_decision == skip"
    },
    {
      "from": "p5",
      "to": "p6",
      "on": "success",
      "condition": "catchup_decision == escalate"
    },
    {
      "from": "p6",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_attempts": 1
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "event_id",
      "trigger_id",
      "instance_id",
      "decision",
      "reason",
      "evidence_ref"
    ]
  },
  "collaboration_policy": {
    "mode": "phase-isolated-session",
    "dispatch_runtime": "openclaw-required",
    "session_reset": "per-phase-reset",
    "natural_context_first": true,
    "ap_migration_strategy": "sequential"
  }
}
