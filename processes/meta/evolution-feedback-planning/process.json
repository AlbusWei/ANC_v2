{
  "process_id": "evolution-feedback-planning",
  "version": "0.2.0",
  "process_level": "P5",
  "parent_process_id": null,
  "composed_processes": [],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m3-evolution-feedback-planning",
  "owner": "bpm",
  "priority": "P1",
  "input_contract": {
    "format": "json",
    "required": [
      "feedback_evidence_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "improvement_plan_ref",
      "retro_report_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "feedback-intake",
      "actor": "system-analyst",
      "target_type": "subprocess",
      "target_id": "inline-ap:evolution-feedback-planning:p1",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-013-incident-triage.md#ap-013-incident-triage",
      "sipoc": {
        "supplier": "initiator",
        "input": "feedback_evidence_ref",
        "process": "normalize runtime feedback and summarize key signals",
        "output": "feedback_digest_ref",
        "client": "p2"
      },
      "acceptance_criteria": "feedback digest is complete and traceable",
      "inline_ap": {
        "ap_id": "inline-ap:evolution-feedback-planning:p1",
        "skill_id": "sys.arch.system-feedback-digest",
        "actor": "system-analyst",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "归一化运行反馈并提炼关键信号",
      "input_context_ref": "feedback_evidence_ref",
      "done_definition": "必须产出 feedback_digest_ref，并满足“反馈摘要完整且可追溯”",
      "handoff_note": "将 feedback_digest_ref 交接给 p2"
    },
    {
      "phase_id": "p2",
      "name": "classify-and-prioritize",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "inline-ap:evolution-feedback-planning:p2",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-014-objective-rubric-iteration.md#ap-014-objective-rubric-iteration",
      "sipoc": {
        "supplier": "p1",
        "input": "feedback_digest_ref",
        "process": "classify issues and define priority buckets",
        "output": "priority_matrix_ref",
        "client": "p3"
      },
      "acceptance_criteria": "priority matrix includes rationale and impact",
      "inline_ap": {
        "ap_id": "inline-ap:evolution-feedback-planning:p2",
        "skill_id": "system.ops.manual-task",
        "actor": "architect",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "对问题进行分类并划定优先级分桶",
      "input_context_ref": "feedback_digest_ref",
      "done_definition": "必须产出 priority_matrix_ref，并满足“优先级矩阵包含依据与影响评估”",
      "handoff_note": "将 priority_matrix_ref 交接给 p3"
    },
    {
      "phase_id": "p3",
      "name": "draft-improvement-plan",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "inline-ap:evolution-feedback-planning:p3",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-015-improvement-planning.md#ap-015-improvement-planning",
      "sipoc": {
        "supplier": "p2",
        "input": "priority_matrix_ref",
        "process": "draft next-cycle improvement plan",
        "output": "improvement_plan_ref",
        "client": "p4"
      },
      "acceptance_criteria": "plan has owner, order and rollback direction",
      "inline_ap": {
        "ap_id": "inline-ap:evolution-feedback-planning:p3",
        "skill_id": "system.ops.manual-task",
        "actor": "architect",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "起草下一轮改进计划",
      "input_context_ref": "priority_matrix_ref",
      "done_definition": "必须产出 improvement_plan_ref，并满足“计划包含负责人、优先级顺序与回滚方向”",
      "handoff_note": "将 improvement_plan_ref 交接给 p4"
    },
    {
      "phase_id": "p4",
      "name": "retro-and-loop-close",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "inline-ap:evolution-feedback-planning:p4",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-017-process-retrospective.md#ap-017-process-retrospective",
      "sipoc": {
        "supplier": "p3",
        "input": "improvement_plan_ref",
        "process": "produce retrospective report and close loop",
        "output": "retro_report_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "retro report and improvement plan are both published",
      "inline_ap": {
        "ap_id": "inline-ap:evolution-feedback-planning:p4",
        "skill_id": "system.ops.manual-task",
        "actor": "architect",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "产出复盘报告并闭环本轮改进",
      "input_context_ref": "improvement_plan_ref",
      "done_definition": "必须产出 retro_report_ref，并满足“复盘报告与改进计划均已发布”",
      "handoff_note": "将 retro_report_ref 交接给 initiator"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_attempts": 1
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason",
      "evidence_ref"
    ]
  },
  "collaboration_policy": {
    "mode": "phase-isolated-session",
    "dispatch_runtime": "openclaw-required",
    "session_reset": "per-phase-reset",
    "natural_context_first": true
  }
}
