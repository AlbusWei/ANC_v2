{
  "process_id": "hotfix",
  "version": "0.2.1",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [
    "hotfix-intake-normalization",
    "hotfix-scope-spec-baseline",
    "quality-gate-preparation",
    "implementation-execution-core",
    "quality-gate-evaluation",
    "release-packaging-governed"
  ],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m3-hotfix-loop",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "incident_context_ref",
      "target_asset_ref",
      "superpower_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "final_gate_verdict_ref",
      "lifecycle_transition_ref",
      "registry_sync_ref",
      "release_package_ref",
      "rollback_bundle_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "hotfix-intake",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "hotfix-intake-normalization",
      "requires_spec": false,
      "sipoc": {
        "supplier": "initiator",
        "input": "incident_context_ref",
        "process": "normalize hotfix objective, impact and rollback direction",
        "output": "hotfix_objective_ref, impact_scope_ref, rollback_direction_ref",
        "client": "p2"
      },
      "acceptance_criteria": "hotfix intake outputs are explicit and executable",
      "phase_purpose": "在应急场景先把问题定义收敛为可执行修复目标，避免团队直接在模糊告警上动手。",
      "input_context_ref": "incident_context_ref,target_asset_ref",
      "done_definition": "必须产出 hotfix_objective_ref、impact_scope_ref、rollback_direction_ref，并明确爆炸半径。",
      "handoff_note": "将 hotfix_objective_ref、impact_scope_ref、rollback_direction_ref 交接给 p2，作为快速规格输入。"
    },
    {
      "phase_id": "p2",
      "name": "scope-and-spec-fast-baseline",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "hotfix-scope-spec-baseline",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-004-spec-authoring.md#ap-004-spec-authoring",
      "sipoc": {
        "supplier": "p1",
        "input": "hotfix_objective_ref and impact_scope_ref",
        "process": "compose scope baseline and spec baseline for hotfix",
        "output": "hotfix_scope_baseline_ref and spec_ref",
        "client": "p3"
      },
      "acceptance_criteria": "scope and spec baseline include rollback and blast radius constraints",
      "phase_purpose": "把应急目标压缩为可执行范围与规格，明确不做什么，控制修复面。",
      "input_context_ref": "hotfix_objective_ref,impact_scope_ref,rollback_direction_ref",
      "done_definition": "必须产出 hotfix_scope_baseline_ref 与 spec_ref，且规格包含回滚约束。",
      "handoff_note": "将 hotfix_scope_baseline_ref 与 spec_ref 交接给 p3。"
    },
    {
      "phase_id": "p3",
      "name": "fast-test-preparation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-preparation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-preparation-process.md#quality-gate-preparation-process",
      "sipoc": {
        "supplier": "p2",
        "input": "spec_ref + superpower_ref",
        "process": "prepare p0-focused hotfix tests",
        "output": "test_plan_ref and preparation_bundle_ref",
        "client": "p4"
      },
      "acceptance_criteria": "test_plan_ref is explicitly linked to spec_ref",
      "phase_purpose": "围绕 hotfix 规格快速建立验证准备，优先覆盖线上风险链路。",
      "input_context_ref": "spec_ref,hotfix_scope_baseline_ref,superpower_ref",
      "done_definition": "必须产出 test_plan_ref 与 preparation_bundle_ref，并覆盖高风险回归点。",
      "handoff_note": "将 test_plan_ref 与 preparation_bundle_ref 交接给 p4。"
    },
    {
      "phase_id": "p4",
      "name": "hotfix-implementation",
      "actor": "kernel-dev",
      "target_type": "subprocess",
      "target_id": "implementation-execution-core",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-006-implementation-execution.md#ap-006-implementation-execution",
      "sipoc": {
        "supplier": "p3",
        "input": "spec_ref and test_plan_ref",
        "process": "implement fix candidate",
        "output": "implementation_ref and candidate_artifacts_ref",
        "client": "p5"
      },
      "acceptance_criteria": "candidate artifacts are traceable to implementation output",
      "phase_purpose": "在受控范围内完成修复实现，输出可评测候选产物。",
      "input_context_ref": "spec_ref,test_plan_ref,preparation_bundle_ref",
      "done_definition": "必须产出 implementation_ref 与 candidate_artifacts_ref，并可追溯到规格。",
      "handoff_note": "将 implementation_ref 与 candidate_artifacts_ref 交接给 p5。"
    },
    {
      "phase_id": "p5",
      "name": "hotfix-gate-evaluation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-evaluation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-evaluation-process.md#quality-gate-evaluation-process",
      "sipoc": {
        "supplier": "p4",
        "input": "candidate_artifacts_ref + superpower_ref",
        "process": "evaluate objective and regression gates",
        "output": "final_gate_verdict_ref",
        "client": "p6"
      },
      "acceptance_criteria": "gate decision is pass/fail and evidence complete",
      "phase_purpose": "给出 hotfix 是否可放行的门禁结论，避免带病发布。",
      "input_context_ref": "candidate_artifacts_ref,implementation_ref,preparation_bundle_ref,superpower_ref",
      "done_definition": "必须产出 final_gate_verdict_ref，结论可解释且证据完整。",
      "handoff_note": "门禁通过后将 final_gate_verdict_ref 交接给 p6；失败回流 p4。"
    },
    {
      "phase_id": "p6",
      "name": "lifecycle-gate-sync",
      "actor": "hr",
      "target_type": "subprocess",
      "target_id": "lifecycle-review",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-011-registry-sync.md#ap-011-registry-sync",
      "sipoc": {
        "supplier": "p5",
        "input": "final_gate_verdict_ref + superpower_ref",
        "process": "validate lifecycle and registry handoff package",
        "output": "lifecycle_transition_ref and registry_sync_ref",
        "client": "p7"
      },
      "acceptance_criteria": "lifecycle and registry handoff package is complete",
      "phase_purpose": "在发布前完成生命周期与 registry 治理收口，确保状态迁移可审计。",
      "input_context_ref": "final_gate_verdict_ref,target_asset_ref,lifecycle_target,superpower_ref",
      "done_definition": "必须产出 lifecycle_transition_ref 与 registry_sync_ref。",
      "handoff_note": "将 lifecycle_transition_ref 与 registry_sync_ref 交接给 p7。"
    },
    {
      "phase_id": "p7",
      "name": "release-packaging",
      "actor": "admin",
      "target_type": "subprocess",
      "target_id": "release-packaging-governed",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-012-release-packaging.md#ap-012-release-packaging",
      "sipoc": {
        "supplier": "p6",
        "input": "candidate_artifacts_ref, final_gate_verdict_ref, lifecycle_transition_ref, registry_sync_ref",
        "process": "package and publish hotfix release",
        "output": "release_package_ref and rollback_bundle_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "release package includes rollback and gate evidence",
      "phase_purpose": "形成可回滚的 hotfix 发布包并完成交付。",
      "input_context_ref": "candidate_artifacts_ref,final_gate_verdict_ref,lifecycle_transition_ref,registry_sync_ref",
      "done_definition": "必须产出 release_package_ref 与 rollback_bundle_ref。",
      "handoff_note": "将 release_package_ref 与 rollback_bundle_ref 交接给 initiator。"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "p4",
      "on": "failure",
      "condition": "iterations < 1"
    },
    {
      "from": "p5",
      "to": "p6",
      "on": "success",
      "condition": "gate_decision == pass"
    },
    {
      "from": "p6",
      "to": "p7",
      "on": "success"
    },
    {
      "from": "p7",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_iterations": 1,
      "from_phase": "p5",
      "to_phase": "p4"
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "incident_ref",
      "input_ref",
      "output_ref",
      "decision",
      "reason",
      "evidence_ref"
    ]
  },
  "process_type": "dev.hotfix",
  "governance_bundle": {
    "syntax_ref": "docs/design/processes/development-loop-core-standard.md",
    "obligation_ref": "docs/design/processes/development-loop-core-standard.md",
    "risk_policy_ref": "docs/design/processes/governance-processes.md",
    "checklist_ref": "docs/design/modules/M3-self-development.md"
  },
  "collaboration_policy": {
    "mode": "phase-isolated-session",
    "dispatch_runtime": "openclaw-required",
    "session_reset": "per-phase-reset",
    "pilot_scope": "expanded-from-full-development",
    "natural_context_first": true,
    "ap_migration_strategy": "sequential"
  }
}
