{
  "process_id": "hotfix",
  "version": "0.1.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [
    "quality-gate-preparation",
    "quality-gate-evaluation"
  ],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m3-hotfix-loop",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "incident_ref",
      "objective_ref",
      "impact_scope",
      "rollback_plan",
      "target_asset_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "hotfix_delivery_bundle_ref",
      "final_gate_verdict_ref",
      "lifecycle_transition_ref",
      "hotfix_release_package_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "hotfix-intake",
      "actor": "architect",
      "target_type": "skill",
      "target_id": "meta.arch.objective-writer",
      "requires_spec": false,
      "sipoc": {
        "supplier": "initiator",
        "input": "incident and objective context",
        "process": "normalize hotfix objective and impact scope",
        "output": "hotfix_objective_ref",
        "client": "p2"
      },
      "acceptance_criteria": "objective, impact and rollback direction are explicit"
    },
    {
      "phase_id": "p2",
      "name": "scope-and-spec-fast-baseline",
      "actor": "architect",
      "target_type": "skill",
      "target_id": "meta.arch.spec-writer",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-004-spec-authoring.md#ap-004-spec-authoring",
      "sipoc": {
        "supplier": "p1",
        "input": "hotfix objective",
        "process": "generate constrained hotfix spec",
        "output": "hotfix_spec_ref",
        "client": "p3"
      },
      "acceptance_criteria": "spec includes rollback and blast radius controls"
    },
    {
      "phase_id": "p3",
      "name": "fast-test-preparation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-preparation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-preparation-process.md#quality-gate-preparation-process",
      "sipoc": {
        "supplier": "p2",
        "input": "hotfix spec",
        "process": "prepare p0-focused hotfix tests",
        "output": "hotfix_preparation_bundle_ref",
        "client": "p4"
      },
      "acceptance_criteria": "hotfix regression scope and p0 coverage are complete"
    },
    {
      "phase_id": "p4",
      "name": "hotfix-implementation",
      "actor": "kernel-dev",
      "target_type": "skill",
      "target_id": "system.ops.manual-task",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-006-implementation-execution.md#ap-006-implementation-execution",
      "sipoc": {
        "supplier": "p3",
        "input": "hotfix_preparation_bundle_ref",
        "process": "implement fix candidate",
        "output": "hotfix_implementation_ref",
        "client": "p5"
      },
      "acceptance_criteria": "hotfix candidate is traceable and reproducible"
    },
    {
      "phase_id": "p5",
      "name": "hotfix-gate-evaluation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-evaluation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-evaluation-process.md#quality-gate-evaluation-process",
      "sipoc": {
        "supplier": "p4",
        "input": "hotfix implementation",
        "process": "evaluate hotfix objective and regression gate",
        "output": "final_gate_verdict_ref",
        "client": "p6"
      },
      "acceptance_criteria": "gate decision is pass/fail and linked to evidence"
    },
    {
      "phase_id": "p6",
      "name": "lifecycle-gate-sync",
      "actor": "admin",
      "target_type": "skill",
      "target_id": "meta.arch.template-validator",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-011-registry-sync.md#ap-011-registry-sync",
      "sipoc": {
        "supplier": "p5",
        "input": "final_gate_verdict_ref",
        "process": "validate lifecycle and registry handoff package",
        "output": "lifecycle_transition_ref",
        "client": "p7"
      },
      "acceptance_criteria": "lifecycle handoff package passes template and contract validation"
    },
    {
      "phase_id": "p7",
      "name": "release-packaging",
      "actor": "admin",
      "target_type": "skill",
      "target_id": "system.ops.manual-task",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-012-release-packaging.md#ap-012-release-packaging",
      "sipoc": {
        "supplier": "p6",
        "input": "lifecycle_transition_ref",
        "process": "package and publish emergency fix",
        "output": "hotfix_release_package_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "release package includes rollback and gate evidence"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "p4",
      "on": "failure",
      "condition": "iterations < 1"
    },
    {
      "from": "p5",
      "to": "p6",
      "on": "success",
      "condition": "gate_decision == pass"
    },
    {
      "from": "p6",
      "to": "p7",
      "on": "success"
    },
    {
      "from": "p7",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_iterations": 1,
      "from_phase": "p5",
      "to_phase": "p4"
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "incident_ref",
      "input_ref",
      "output_ref",
      "decision",
      "reason",
      "evidence_ref"
    ]
  }
}
