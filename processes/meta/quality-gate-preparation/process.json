{
  "process_id": "quality-gate-preparation",
  "version": "0.1.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m1-unified-quality-gate",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "objective_ref",
      "spec_ref",
      "test_doc_ref",
      "risk_focus"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "preparation_bundle_ref",
      "preparation_evidence_ref",
      "verdict"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "design-tests",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "inline-ap:quality-gate-preparation:p1",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-preparation-process.md#阶段定义",
      "sipoc": {
        "supplier": "initiator",
        "input": "objective_ref + spec_ref + test_doc_ref",
        "process": "design objective aligned tests with P0 coverage",
        "output": "test_plan_ref",
        "client": "p2"
      },
      "acceptance_criteria": "P0 risk coverage is explicit and traceable",
      "inline_ap": {
        "ap_id": "inline-ap:quality-gate-preparation:p1",
        "skill_id": "meta.qa.test-designer",
        "actor": "qa",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      }
    },
    {
      "phase_id": "p2",
      "name": "compile-test-datapoints",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "inline-ap:quality-gate-preparation:p2",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-018-test-datapoint-compilation.md#AP-018-Test-Datapoint-Compilation",
      "sipoc": {
        "supplier": "p1",
        "input": "test_plan_ref + test_doc_ref",
        "process": "compile TEST.md into executable datapoints",
        "output": "test_datapoints_ref + compile_report_ref",
        "client": "p3"
      },
      "acceptance_criteria": "compile report is complete and datapoints are executable",
      "inline_ap": {
        "ap_id": "inline-ap:quality-gate-preparation:p2",
        "skill_id": "sys.qa.test-compiler",
        "actor": "qa",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      }
    },
    {
      "phase_id": "p3",
      "name": "bind-test-profiles",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "inline-ap:quality-gate-preparation:p3",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-019-test-profile-binding.md#AP-019-Test-Profile-Binding",
      "sipoc": {
        "supplier": "p2",
        "input": "test_datapoints_ref + compile_report_ref + profile_set",
        "process": "bind tc_id to profile_id and package preparation bundle",
        "output": "preparation_bundle_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "tc_id profile_id mapping is one-to-one and traceable",
      "inline_ap": {
        "ap_id": "inline-ap:quality-gate-preparation:p3",
        "skill_id": "sys.qa.test-compiler",
        "actor": "qa",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      }
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_attempts": 1
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason"
    ]
  }
}
