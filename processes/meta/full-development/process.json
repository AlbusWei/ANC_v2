{
  "process_id": "full-development",
  "version": "0.1.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [
    "quality-gate-preparation",
    "quality-gate-evaluation"
  ],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m3-full-development-loop",
  "owner": "bpm",
  "priority": "P1",
  "input_contract": {
    "format": "json",
    "required": [
      "objective_ref",
      "input_payload",
      "target_asset_type",
      "lifecycle_target"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "m3_delivery_bundle_ref",
      "final_gate_verdict_ref",
      "lifecycle_transition_ref",
      "registry_sync_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "objective-intake-and-scope",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "ap-001-002-003-bundle",
      "requires_spec": false,
      "sipoc": {
        "supplier": "initiator",
        "input": "objective and problem context",
        "process": "structure objective and initial scope baseline",
        "output": "objective_ref",
        "client": "p2"
      },
      "acceptance_criteria": "objective has measurable success criteria and explicit constraints"
    },
    {
      "phase_id": "p2",
      "name": "spec-authoring",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "ap-004-bundle",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-004-spec-authoring.md#ap-004-spec-authoring",
      "sipoc": {
        "supplier": "p1",
        "input": "objective_ref",
        "process": "produce executable spec contract",
        "output": "spec_ref",
        "client": "p3"
      },
      "acceptance_criteria": "spec contains io contract, acceptance criteria and rollback direction"
    },
    {
      "phase_id": "p3",
      "name": "quality-gate-preparation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-preparation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-preparation-process.md#quality-gate-preparation-process",
      "sipoc": {
        "supplier": "p2",
        "input": "spec_ref",
        "process": "design tests and prepare gate input bundle",
        "output": "preparation_bundle_ref",
        "client": "p4"
      },
      "acceptance_criteria": "p0 tests and traceability bundle are complete"
    },
    {
      "phase_id": "p4",
      "name": "implementation-execution",
      "actor": "kernel-dev",
      "target_type": "subprocess",
      "target_id": "ap-006-bundle",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-006-implementation-execution.md#ap-006-implementation-execution",
      "sipoc": {
        "supplier": "p3",
        "input": "preparation_bundle_ref",
        "process": "produce implementation output",
        "output": "implementation_ref",
        "client": "p5"
      },
      "acceptance_criteria": "implementation is traceable to spec and test plan"
    },
    {
      "phase_id": "p5",
      "name": "quality-gate-evaluation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-evaluation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-evaluation-process.md#quality-gate-evaluation-process",
      "sipoc": {
        "supplier": "p4",
        "input": "implementation_ref",
        "process": "evaluate output against objective and test constraints",
        "output": "final_gate_verdict_ref",
        "client": "p6"
      },
      "acceptance_criteria": "gate decision is parseable and evidence is auditable"
    },
    {
      "phase_id": "p6",
      "name": "lifecycle-gate-sync",
      "actor": "admin",
      "target_type": "subprocess",
      "target_id": "lifecycle-review",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-010-lifecycle-transition.md#ap-010-lifecycle-transition",
      "sipoc": {
        "supplier": "p5",
        "input": "final_gate_verdict_ref",
        "process": "validate lifecycle handoff package and registry sync payload",
        "output": "lifecycle_transition_ref",
        "client": "p7"
      },
      "acceptance_criteria": "handoff package contains lifecycle and registry required fields"
    },
    {
      "phase_id": "p7",
      "name": "release-packaging",
      "actor": "admin",
      "target_type": "subprocess",
      "target_id": "ap-012-bundle",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-012-release-packaging.md#ap-012-release-packaging",
      "sipoc": {
        "supplier": "p6",
        "input": "lifecycle_transition_ref",
        "process": "assemble release package when required",
        "output": "release_package_ref",
        "client": "p8"
      },
      "acceptance_criteria": "release package includes test and lifecycle evidence"
    },
    {
      "phase_id": "p8",
      "name": "evolution-feedback-planning",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "ap-013-014-015-017-bundle",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-015-improvement-planning.md#ap-015-improvement-planning",
      "sipoc": {
        "supplier": "p7",
        "input": "release and runtime feedback",
        "process": "plan next process-level improvements",
        "output": "m3_delivery_bundle_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "improvement planning output is traceable and prioritized"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "p4",
      "on": "failure",
      "condition": "iterations < 2"
    },
    {
      "from": "p5",
      "to": "p6",
      "on": "success",
      "condition": "gate_decision == pass"
    },
    {
      "from": "p6",
      "to": "p7",
      "on": "success"
    },
    {
      "from": "p7",
      "to": "p8",
      "on": "success"
    },
    {
      "from": "p8",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_iterations": 2,
      "from_phase": "p5",
      "to_phase": "p4"
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason",
      "evidence_ref"
    ]
  },
  "process_type": "dev.internal-productization",
  "governance_bundle": {
    "syntax_ref": "docs/design/processes/development-loop-core-standard.md",
    "obligation_ref": "docs/design/processes/development-loop-core-standard.md",
    "risk_policy_ref": "docs/design/processes/governance-processes.md",
    "checklist_ref": "docs/design/modules/M3-self-development.md"
  }
}
