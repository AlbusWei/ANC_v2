{
  "process_id": "full-development",
  "version": "0.3.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [
    "objective-scope-baseline",
    "spec-authoring-contract",
    "quality-gate-preparation",
    "implementation-execution-core",
    "quality-gate-evaluation",
    "release-packaging-governed",
    "evolution-feedback-planning"
  ],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m3-full-development-loop",
  "owner": "bpm",
  "priority": "P1",
  "input_contract": {
    "format": "json",
    "required": [
      "objective_context_ref",
      "input_payload",
      "target_asset_type",
      "lifecycle_target"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "final_gate_verdict_ref",
      "lifecycle_transition_ref",
      "registry_sync_ref",
      "release_package_ref",
      "improvement_plan_ref",
      "retro_report_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "objective-intake-and-scope",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "objective-scope-baseline",
      "requires_spec": false,
      "sipoc": {
        "supplier": "initiator",
        "input": "objective_context_ref",
        "process": "normalize objective and scope baseline",
        "output": "objective_ref and scope_baseline_ref",
        "client": "p2"
      },
      "acceptance_criteria": "objective and scope baseline are traceable and closed",
      "phase_purpose": "澄清目标并形成范围基线，为后续规格编写提供稳定输入。",
      "input_context_ref": "objective_context_ref,input_payload",
      "done_definition": "必须产出 objective_ref 与 scope_baseline_ref。",
      "handoff_note": "将 objective_ref 与 scope_baseline_ref 交接给 p2。"
    },
    {
      "phase_id": "p2",
      "name": "spec-authoring",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "spec-authoring-contract",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-004-spec-authoring.md#ap-004-spec-authoring",
      "sipoc": {
        "supplier": "p1",
        "input": "objective_ref and scope_baseline_ref",
        "process": "produce executable spec contract",
        "output": "spec_ref",
        "client": "p3"
      },
      "acceptance_criteria": "spec contains io contract, acceptance criteria and rollback direction",
      "phase_purpose": "将目标与范围基线收敛为可执行规格。",
      "input_context_ref": "objective_ref,scope_baseline_ref",
      "done_definition": "必须产出 spec_ref，并可追溯到 p1 输入。",
      "handoff_note": "将 spec_ref 交接给 p3。"
    },
    {
      "phase_id": "p3",
      "name": "quality-gate-preparation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-preparation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-preparation-process.md#quality-gate-preparation-process",
      "sipoc": {
        "supplier": "p2",
        "input": "spec_ref",
        "process": "design tests and compile preparation bundle",
        "output": "test_plan_ref and preparation_bundle_ref",
        "client": "p4"
      },
      "acceptance_criteria": "test_plan_ref is explicit and traceable to spec_ref",
      "phase_purpose": "围绕规格构建测试准备包，明确后续验证基线。",
      "input_context_ref": "spec_ref",
      "done_definition": "必须产出 test_plan_ref 与 preparation_bundle_ref。",
      "handoff_note": "将 test_plan_ref 与 preparation_bundle_ref 交接给 p4。"
    },
    {
      "phase_id": "p4",
      "name": "implementation-execution",
      "actor": "kernel-dev",
      "target_type": "subprocess",
      "target_id": "implementation-execution-core",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-006-implementation-execution.md#ap-006-implementation-execution",
      "sipoc": {
        "supplier": "p3",
        "input": "spec_ref and test_plan_ref",
        "process": "produce implementation and candidate artifacts",
        "output": "implementation_ref and candidate_artifacts_ref",
        "client": "p5"
      },
      "acceptance_criteria": "candidate_artifacts_ref is explicitly mapped from implementation_ref",
      "phase_purpose": "在规格与测试基线约束下完成实现与候选产物。",
      "input_context_ref": "spec_ref,test_plan_ref",
      "done_definition": "必须产出 implementation_ref 与 candidate_artifacts_ref。",
      "handoff_note": "将 candidate_artifacts_ref 交接给 p5。"
    },
    {
      "phase_id": "p5",
      "name": "quality-gate-evaluation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-evaluation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-evaluation-process.md#quality-gate-evaluation-process",
      "sipoc": {
        "supplier": "p4",
        "input": "candidate_artifacts_ref",
        "process": "evaluate candidate artifacts against objective and tests",
        "output": "final_gate_verdict_ref",
        "client": "p6"
      },
      "acceptance_criteria": "gate decision is parseable and evidence is auditable",
      "phase_purpose": "执行质量门禁评测并形成统一门禁结论。",
      "input_context_ref": "candidate_artifacts_ref,preparation_bundle_ref",
      "done_definition": "必须产出 final_gate_verdict_ref，且门禁结论可解释。",
      "handoff_note": "若门禁通过，则将 final_gate_verdict_ref 交接给 p6。"
    },
    {
      "phase_id": "p6",
      "name": "lifecycle-gate-sync",
      "actor": "hr",
      "target_type": "subprocess",
      "target_id": "lifecycle-review",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-010-lifecycle-transition.md#ap-010-lifecycle-transition",
      "sipoc": {
        "supplier": "p5",
        "input": "final_gate_verdict_ref",
        "process": "validate lifecycle handoff and registry sync package",
        "output": "lifecycle_transition_ref and registry_sync_ref",
        "client": "p7"
      },
      "acceptance_criteria": "lifecycle and registry payload are both complete",
      "phase_purpose": "完成生命周期治理与 registry 同步前置校验。",
      "input_context_ref": "final_gate_verdict_ref,lifecycle_target",
      "done_definition": "必须产出 lifecycle_transition_ref 与 registry_sync_ref。",
      "handoff_note": "将 lifecycle_transition_ref 与 registry_sync_ref 交接给 p7。"
    },
    {
      "phase_id": "p7",
      "name": "release-packaging",
      "actor": "admin",
      "target_type": "subprocess",
      "target_id": "release-packaging-governed",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-012-release-packaging.md#ap-012-release-packaging",
      "sipoc": {
        "supplier": "p6",
        "input": "candidate_artifacts_ref, final_gate_verdict_ref, lifecycle_transition_ref, registry_sync_ref",
        "process": "package release bundle with governed decision",
        "output": "release_package_ref, changelog_ref, release_decision, rollback_bundle_ref",
        "client": "p8"
      },
      "acceptance_criteria": "release decision and rollback bundle are explicit",
      "phase_purpose": "完成发布打包与回滚包准备。",
      "input_context_ref": "candidate_artifacts_ref,final_gate_verdict_ref,lifecycle_transition_ref,registry_sync_ref",
      "done_definition": "必须产出 release_package_ref 与 rollback_bundle_ref。",
      "handoff_note": "将发布产物与反馈证据交接给 p8。"
    },
    {
      "phase_id": "p8",
      "name": "evolution-feedback-planning",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "evolution-feedback-planning",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-015-improvement-planning.md#ap-015-improvement-planning",
      "sipoc": {
        "supplier": "p7",
        "input": "feedback_evidence_ref (aggregated from release, gate and runtime evidence)",
        "process": "produce improvement planning and retrospective outputs",
        "output": "improvement_plan_ref and retro_report_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "feedback evidence aggregation source is explicit and reproducible",
      "phase_purpose": "基于发布与运行反馈形成下一轮演化计划。",
      "input_context_ref": "release_package_ref,final_gate_verdict_ref,lifecycle_transition_ref,runtime_feedback_ref",
      "done_definition": "必须产出 improvement_plan_ref 与 retro_report_ref。",
      "handoff_note": "将演化计划回填给发起方作为下一轮输入。"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "p4",
      "on": "failure",
      "condition": "iterations < 2"
    },
    {
      "from": "p5",
      "to": "p6",
      "on": "success",
      "condition": "gate_decision == pass"
    },
    {
      "from": "p6",
      "to": "p7",
      "on": "success"
    },
    {
      "from": "p7",
      "to": "p8",
      "on": "success"
    },
    {
      "from": "p8",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_iterations": 2,
      "from_phase": "p5",
      "to_phase": "p4"
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason",
      "evidence_ref"
    ]
  },
  "process_type": "dev.internal-productization",
  "governance_bundle": {
    "syntax_ref": "docs/design/processes/development-loop-core-standard.md",
    "obligation_ref": "docs/design/processes/development-loop-core-standard.md",
    "risk_policy_ref": "docs/design/processes/governance-processes.md",
    "checklist_ref": "docs/design/modules/M3-self-development.md"
  },
  "collaboration_policy": {
    "mode": "phase-isolated-session",
    "dispatch_runtime": "openclaw-required",
    "session_reset": "per-phase-reset",
    "pilot_scope": "full-development-first",
    "natural_context_first": true,
    "ap_migration_strategy": "sequential"
  }
}
