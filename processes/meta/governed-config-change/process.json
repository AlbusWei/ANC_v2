{
  "process_id": "governed-config-change",
  "version": "0.1.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-governed-openclaw-config-change",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "objective_ref",
      "change_request",
      "requester",
      "target_scope",
      "rollback_plan"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "final_output",
      "evidence_refs",
      "verdict",
      "change_receipt"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "intake-and-normalize",
      "actor": "bpm",
      "skill_or_process": "manual-task",
      "sipoc": {
        "supplier": "initiator",
        "input": "change_request",
        "process": "normalize request into structured config_change_request",
        "output": "normalized_request",
        "client": "p2"
      },
      "acceptance_criteria": "request includes target scope, expected impact and rollback plan"
    },
    {
      "phase_id": "p2",
      "name": "gate-and-risk-classification",
      "actor": "bpm",
      "skill_or_process": "config-change-gatekeeper",
      "sipoc": {
        "supplier": "p1",
        "input": "normalized_request",
        "process": "validate required evidence and classify risk",
        "output": "approved_request",
        "client": "p3"
      },
      "acceptance_criteria": "objective/spec/test chain complete and risk level recorded"
    },
    {
      "phase_id": "p3",
      "name": "authorize-change",
      "actor": "admin",
      "skill_or_process": "manual-task",
      "sipoc": {
        "supplier": "p2",
        "input": "approved_request",
        "process": "approve or reject execution window and scope",
        "output": "authorization_decision",
        "client": "p4"
      },
      "acceptance_criteria": "authorization decision includes approval, constraints and rollback trigger"
    },
    {
      "phase_id": "p4",
      "name": "execute-config-change",
      "actor": "admin",
      "skill_or_process": "system-config-updater",
      "sipoc": {
        "supplier": "p3",
        "input": "authorization_decision",
        "process": "apply OpenClaw config change with baseHash and capture receipt",
        "output": "change_receipt",
        "client": "p5"
      },
      "acceptance_criteria": "change receipt contains hash_before/hash_after, patch summary and execution status"
    },
    {
      "phase_id": "p5",
      "name": "verify-and-archive",
      "actor": "bpm",
      "skill_or_process": "manual-task",
      "sipoc": {
        "supplier": "p4",
        "input": "change_receipt",
        "process": "verify post-change health, archive evidence and notify requester",
        "output": "final_output",
        "client": "initiator"
      },
      "acceptance_criteria": "health verification pass and evidence bundle is complete"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_attempts": 1
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "control": {
    "mode": "sequence",
    "retries": {
      "max_attempts": 1
    }
  },
  "failure_policy": {
    "mode": "fail_closed",
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason",
      "hash_before",
      "hash_after",
      "rollback_status"
    ]
  }
}
