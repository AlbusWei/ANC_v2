{
  "process_id": "hold-governance",
  "version": "0.2.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m1-unified-quality-gate",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "hold_case_ref",
      "runtime_log_ref",
      "execution_state_ref",
      "triage_policy_ref",
      "runtime_health_policy_ref",
      "liveness_policy_ref",
      "no_progress_window_ref",
      "termination_rule_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "triage_report_ref",
      "health_maintenance_ref",
      "hold_resolution_ref",
      "external_gate_decision"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "collect-progress-evidence",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "inline-ap:hold-governance:p1",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-021-hold-progress-evidence-collection.md#AP-021-Hold-Progress-Evidence-Collection",
      "sipoc": {
        "supplier": "initiator",
        "input": "hold_case_ref + runtime_log_ref + execution_state_ref + liveness_policy_ref + no_progress_window_ref",
        "process": "collect minimum progress signals",
        "output": "progress_signals_ref",
        "client": "p2"
      },
      "acceptance_criteria": "three progress signal categories are collected or explicit failure recorded",
      "inline_ap": {
        "ap_id": "inline-ap:hold-governance:p1",
        "skill_id": "sys.qa.hold-triage",
        "actor": "qa",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "收集最小进展信号集",
      "input_context_ref": "hold_case_ref + runtime_log_ref + execution_state_ref + liveness_policy_ref + no_progress_window_ref",
      "done_definition": "必须产出 progress_signals_ref，并满足“三类进展信号已收集或已明确记录失败原因”",
      "handoff_note": "将 progress_signals_ref 交接给 p2"
    },
    {
      "phase_id": "p2",
      "name": "triage-and-classify",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "inline-ap:hold-governance:p2",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-022-hold-triage-classification.md#AP-022-Hold-Triage-Classification",
      "sipoc": {
        "supplier": "p1",
        "input": "progress_signals_ref + triage_policy_ref",
        "process": "classify hold action",
        "output": "triage_action",
        "client": "p3"
      },
      "acceptance_criteria": "triage action is explicit and policy compliant",
      "inline_ap": {
        "ap_id": "inline-ap:hold-governance:p2",
        "skill_id": "sys.qa.hold-triage",
        "actor": "qa",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "对 hold 场景进行处置分级",
      "input_context_ref": "progress_signals_ref + triage_policy_ref",
      "done_definition": "必须产出 triage_action，并满足“分诊动作明确且符合策略”",
      "handoff_note": "将 triage_action 交接给 p3"
    },
    {
      "phase_id": "p3",
      "name": "execute-triage-action",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "inline-ap:hold-governance:p3",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-023-hold-triage-action-execution.md#AP-023-Hold-Triage-Action-Execution",
      "sipoc": {
        "supplier": "p2",
        "input": "triage_action + triage_report_ref",
        "process": "execute selected triage action",
        "output": "action_execution_ref",
        "client": "p4"
      },
      "acceptance_criteria": "action execution matches triage decision",
      "inline_ap": {
        "ap_id": "inline-ap:hold-governance:p3",
        "skill_id": "sys.qa.hold-triage",
        "actor": "qa",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "执行选定的分诊动作",
      "input_context_ref": "triage_action + triage_report_ref",
      "done_definition": "必须产出 action_execution_ref，并满足“动作执行与分诊决策一致”",
      "handoff_note": "将 action_execution_ref 交接给 p4"
    },
    {
      "phase_id": "p4",
      "name": "health-maintenance",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "inline-ap:hold-governance:p4",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-024-runtime-health-maintenance.md#AP-024-Runtime-Health-Maintenance",
      "sipoc": {
        "supplier": "p3",
        "input": "action_execution_ref + runtime_health_policy_ref + no_progress_window_ref + termination_rule_ref",
        "process": "maintain runtime health and recovery state",
        "output": "health_maintenance_ref",
        "client": "p5"
      },
      "acceptance_criteria": "health result is traceable and recoverability is explicit",
      "inline_ap": {
        "ap_id": "inline-ap:hold-governance:p4",
        "skill_id": "sys.bpm.process-instance-manager",
        "actor": "bpm",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "维护运行时健康与恢复状态",
      "input_context_ref": "action_execution_ref + runtime_health_policy_ref + no_progress_window_ref + termination_rule_ref",
      "done_definition": "必须产出 health_maintenance_ref，并满足“健康结果可追溯且可恢复性明确”",
      "handoff_note": "将 health_maintenance_ref 交接给 p5"
    },
    {
      "phase_id": "p5",
      "name": "close-or-escalate",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "inline-ap:hold-governance:p5",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-025-hold-resolution-and-escalation.md#AP-025-Hold-Resolution-and-Escalation",
      "sipoc": {
        "supplier": "p4",
        "input": "triage_action + health_maintenance_ref + termination_rule_ref",
        "process": "close hold case or escalate with external fail-closed gate",
        "output": "hold_resolution_ref + external_gate_decision",
        "client": "initiator"
      },
      "acceptance_criteria": "hold case closes or escalates along governed chain",
      "inline_ap": {
        "ap_id": "inline-ap:hold-governance:p5",
        "skill_id": "sys.bpm.escalation-handler",
        "actor": "bpm",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "收敛 hold 案例或继续升级",
      "input_context_ref": "triage_action + health_maintenance_ref + termination_rule_ref",
      "done_definition": "必须产出 hold_resolution_ref + external_gate_decision，并满足“hold 案例按治理链路收敛或升级且对外门禁保持 fail-closed”",
      "handoff_note": "将 hold_resolution_ref + external_gate_decision 交接给 initiator"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_attempts": 1
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason"
    ]
  },
  "collaboration_policy": {
    "mode": "phase-isolated-session",
    "dispatch_runtime": "openclaw-required",
    "session_reset": "per-phase-reset",
    "natural_context_first": true,
    "ap_migration_strategy": "sequential"
  }
}
