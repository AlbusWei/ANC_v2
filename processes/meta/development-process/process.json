{
  "process_id": "development-process",
  "version": "0.1.0",
  "objective_ref": "obj-phase1-min-loop",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": ["objective_ref", "input_payload"]
  },
  "output_contract": {
    "format": "json",
    "required": ["final_output", "evidence_refs", "verdict"]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "write-spec",
      "actor": "architect",
      "skill_or_process": "spec-writer",
      "sipoc": {
        "supplier": "initiator",
        "input": "input_payload",
        "process": "draft objective-aligned spec",
        "output": "spec_doc",
        "client": "p2"
      },
      "acceptance_criteria": "spec includes scope, I/O contract and acceptance criteria"
    },
    {
      "phase_id": "p2",
      "name": "design-tests",
      "actor": "qa",
      "skill_or_process": "test-designer",
      "sipoc": {
        "supplier": "p1",
        "input": "spec_doc",
        "process": "design objective-aligned tests",
        "output": "test_plan",
        "client": "p3"
      },
      "acceptance_criteria": "test plan covers objective core intent and P0 cases"
    },
    {
      "phase_id": "p3",
      "name": "implement",
      "actor": "kernel-dev",
      "skill_or_process": "manual-task",
      "sipoc": {
        "supplier": "p2",
        "input": "test_plan",
        "process": "produce implementation candidate",
        "output": "candidate_output",
        "client": "p4"
      },
      "acceptance_criteria": "candidate output is generated and traceable"
    },
    {
      "phase_id": "p4",
      "name": "verify",
      "actor": "qa",
      "skill_or_process": "llm-judge",
      "sipoc": {
        "supplier": "p3",
        "input": "candidate_output",
        "process": "evaluate against objective and test conditions",
        "output": "verdict",
        "client": "initiator"
      },
      "acceptance_criteria": "verdict has pass/fail, confidence and improvement suggestions"
    }
  ],
  "control": {
    "mode": "sequence",
    "loop_on_failure": {
      "from_phase": "p4",
      "to_phase": "p3",
      "max_iterations": 2
    }
  },
  "failure_policy": {
    "mode": "fail_closed",
    "escalation_chain": ["actor", "owner", "bpm", "admin"]
  },
  "evidence_policy": {
    "required_fields": ["timestamp", "phase_id", "actor", "input_ref", "output_ref", "decision", "reason"]
  }
}
