{
  "process_id": "development-process",
  "version": "0.5.1",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [
    "objective-scope-baseline",
    "spec-authoring-contract",
    "quality-gate-preparation",
    "implementation-execution-core",
    "quality-gate-evaluation",
    "lifecycle-review"
  ],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-phase1-min-loop",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "objective_context_ref",
      "target_asset_ref",
      "requested_transition",
      "superpower_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "objective_ref",
      "scope_baseline_ref",
      "spec_ref",
      "test_plan_ref",
      "implementation_ref",
      "final_gate_verdict_ref",
      "lifecycle_transition_ref",
      "registry_sync_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "objective-scope-baseline",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "objective-scope-baseline",
      "requires_spec": false,
      "sipoc": {
        "supplier": "initiator",
        "input": "objective_context_ref",
        "process": "normalize objective and scope baseline",
        "output": "objective_ref and scope_baseline_ref",
        "client": "p2"
      },
      "acceptance_criteria": "objective and scope baseline are complete",
      "phase_purpose": "把开发需求先收敛成可执行目标与范围基线，避免后续阶段在语义不清的输入上反复返工。",
      "input_context_ref": "objective_context_ref",
      "done_definition": "必须产出 objective_ref 与 scope_baseline_ref，并明确本轮开发不覆盖的范围。",
      "handoff_note": "将 objective_ref 与 scope_baseline_ref 交接给 p2，作为规格编写唯一输入基线。"
    },
    {
      "phase_id": "p2",
      "name": "spec-authoring-contract",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "spec-authoring-contract",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-004-spec-authoring.md#ap-004-spec-authoring",
      "sipoc": {
        "supplier": "p1",
        "input": "objective_ref and scope_baseline_ref",
        "process": "produce executable spec",
        "output": "spec_ref",
        "client": "p3"
      },
      "acceptance_criteria": "spec contract is parseable and auditable",
      "phase_purpose": "将目标与范围翻译为可执行规格，让开发与测试共享同一份可追溯语义。",
      "input_context_ref": "objective_ref,scope_baseline_ref",
      "done_definition": "必须产出 spec_ref，且规格包含验收标准与必要约束。",
      "handoff_note": "将 spec_ref 交接给 p3，用于质量门禁准备。"
    },
    {
      "phase_id": "p3",
      "name": "quality-gate-preparation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-preparation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-preparation-process.md#quality-gate-preparation-process",
      "sipoc": {
        "supplier": "p2",
        "input": "spec_ref + superpower_ref",
        "process": "prepare quality gate test plan",
        "output": "test_plan_ref",
        "client": "p4"
      },
      "acceptance_criteria": "test plan is complete and traceable",
      "phase_purpose": "在实现前完成测试准备，确保实现阶段不是盲写代码，而是对齐可验证目标。",
      "input_context_ref": "spec_ref,superpower_ref",
      "done_definition": "必须产出 test_plan_ref，并明确关键链路的验证方法。",
      "handoff_note": "将 test_plan_ref 交接给 p4，作为实现阶段的验证约束。"
    },
    {
      "phase_id": "p4",
      "name": "implementation-execution-core",
      "actor": "kernel-dev",
      "target_type": "subprocess",
      "target_id": "implementation-execution-core",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-006-implementation-execution.md#ap-006-implementation-execution",
      "sipoc": {
        "supplier": "p3",
        "input": "spec_ref and test_plan_ref",
        "process": "produce implementation candidate",
        "output": "implementation_ref",
        "client": "p5"
      },
      "acceptance_criteria": "implementation is generated and linked to tests",
      "phase_purpose": "在规格与测试基线下完成实现候选物，保证产物可被门禁直接评测。",
      "input_context_ref": "spec_ref,test_plan_ref",
      "done_definition": "必须产出 implementation_ref，且实现与规格/测试计划有明确映射。",
      "handoff_note": "将 implementation_ref 交接给 p5，进入统一门禁评测。"
    },
    {
      "phase_id": "p5",
      "name": "quality-gate-evaluation",
      "actor": "qa",
      "target_type": "subprocess",
      "target_id": "quality-gate-evaluation",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-evaluation-process.md#quality-gate-evaluation-process",
      "sipoc": {
        "supplier": "p4",
        "input": "implementation_ref + superpower_ref",
        "process": "evaluate candidate against objective and test conditions",
        "output": "final_gate_verdict_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "verdict has pass/fail and evidence references",
      "phase_purpose": "输出可执行的放行结论，让上层业务流程决定是否继续生命周期、发布或回退。",
      "input_context_ref": "implementation_ref,test_plan_ref,objective_ref,superpower_ref",
      "done_definition": "必须产出 final_gate_verdict_ref，包含 pass/fail 与关键证据。",
      "handoff_note": "门禁通过则交接给 p6 进入生命周期治理；失败按回路回流 p4 迭代修复。"
    },
    {
      "phase_id": "p6",
      "name": "lifecycle-gate-sync",
      "actor": "hr",
      "target_type": "subprocess",
      "target_id": "lifecycle-review",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/lifecycle-review-process.md#目标",
      "sipoc": {
        "supplier": "p5",
        "input": "final_gate_verdict_ref + target_asset_ref + requested_transition + superpower_ref",
        "process": "execute lifecycle review and registry sync",
        "output": "lifecycle_transition_ref and registry_sync_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "lifecycle transition and registry sync records are both complete and traceable",
      "phase_purpose": "在开发闭环内完成最小生命周期治理收口，确保通过门禁的资产具备可审计状态迁移记录。",
      "input_context_ref": "final_gate_verdict_ref,target_asset_ref,requested_transition,superpower_ref",
      "done_definition": "必须产出 lifecycle_transition_ref 与 registry_sync_ref，并满足生命周期评审报告可追溯。",
      "handoff_note": "将 lifecycle_transition_ref 与 registry_sync_ref 交接给 initiator。"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "p4",
      "on": "failure",
      "condition": "iterations < 2"
    },
    {
      "from": "p5",
      "to": "p6",
      "on": "success",
      "condition": "gate_decision == pass"
    },
    {
      "from": "p6",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_iterations": 2,
      "from_phase": "p5",
      "to_phase": "p4"
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason"
    ]
  },
  "process_type": "dev.prototype",
  "governance_bundle": {
    "syntax_ref": "docs/design/processes/development-loop-core-standard.md",
    "obligation_ref": "docs/design/processes/development-loop-core-standard.md",
    "risk_policy_ref": "docs/design/processes/governance-processes.md",
    "checklist_ref": "docs/design/modules/M3-self-development.md"
  },
  "collaboration_policy": {
    "mode": "phase-isolated-session",
    "dispatch_runtime": "openclaw-required",
    "session_reset": "per-phase-reset",
    "pilot_scope": "development-process-baseline",
    "natural_context_first": true,
    "ap_migration_strategy": "sequential"
  }
}
