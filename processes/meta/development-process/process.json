{
  "process_id": "development-process",
  "version": "0.2.0",
  "objective_ref": "obj-phase1-min-loop",
  "owner": "bpm",
  "priority": "P0",
  "runtime_baseline": true,
  "input_contract": {
    "format": "json",
    "required": [
      "objective_ref",
      "input_payload",
      "test_case_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "final_output",
      "evidence_refs",
      "verdict",
      "fail_closed"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "write-spec",
      "actor": "architect",
      "skill_or_process": "spec-writer",
      "sipoc": {
        "supplier": "initiator",
        "input": "input_payload",
        "process": "draft objective-aligned spec",
        "output": "spec_doc",
        "client": "p2"
      },
      "acceptance_criteria": "spec includes scope, I/O contract and acceptance criteria"
    },
    {
      "phase_id": "p2",
      "name": "design-tests",
      "actor": "qa",
      "skill_or_process": "test-designer",
      "sipoc": {
        "supplier": "p1",
        "input": "spec_doc",
        "process": "design objective-aligned tests",
        "output": "test_plan",
        "client": "p3"
      },
      "acceptance_criteria": "test plan covers objective core intent and P0 cases"
    },
    {
      "phase_id": "p3",
      "name": "implement",
      "actor": "kernel-dev",
      "skill_or_process": "manual-task",
      "sipoc": {
        "supplier": "p2",
        "input": "test_plan",
        "process": "produce implementation candidate",
        "output": "candidate_output",
        "client": "p4"
      },
      "acceptance_criteria": "candidate output is generated and traceable"
    },
    {
      "phase_id": "p4",
      "name": "verify-with-scenario-gate",
      "actor": "qa",
      "skill_or_process": "llm-judge",
      "sipoc": {
        "supplier": "p3",
        "input": "candidate_output + test_plan",
        "process": "run scenario backend evaluation and normalize into ANC gate verdict",
        "output": "normalized_verdict",
        "client": "initiator"
      },
      "phase_contract": {
        "input_required": [
          "objective",
          "spec_ref",
          "expected_conditions",
          "actual_output_ref",
          "test_case_ref",
          "evaluation_mode",
          "backend",
          "timeout_seconds",
          "evidence_root"
        ],
        "output_required": [
          "pass",
          "confidence",
          "remarks",
          "suggestions",
          "evidence_refs",
          "judge_backend",
          "fail_closed",
          "fail_closed_reason"
        ]
      },
      "acceptance_criteria": "normalized verdict contains pass/confidence/remarks/suggestions/evidence_refs and fail-closed guard status"
    }
  ],
  "control": {
    "mode": "sequence",
    "loop_on_failure": {
      "from_phase": "p4",
      "to_phase": "p3",
      "max_iterations": 2
    }
  },
  "failure_policy": {
    "mode": "fail_closed",
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin"
    ]
  },
  "runtime_policy": {
    "verify_backend_default": "scenario_python",
    "gate_requires_normalized_verdict": true,
    "forbid_direct_scenario_result": true
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason",
      "evidence_refs"
    ],
    "verify_required_artifacts": [
      "scenario/transcript.json",
      "scenario/raw_result.json",
      "scenario/normalized_verdict.json",
      "scenario/fail_closed_guard.json"
    ]
  }
}
