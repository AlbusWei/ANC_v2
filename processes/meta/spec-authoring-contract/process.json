      "objective_ref",
      "scope_baseline_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "spec_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "spec-authoring",
      "actor": "architect",
      "target_type": "subprocess",
      "target_id": "inline-ap:spec-authoring-contract:p1",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-004-spec-authoring.md#ap-004-spec-authoring",
      "sipoc": {
        "supplier": "initiator",
        "input": "objective_ref and scope_baseline_ref",
        "process": "produce executable spec contract",
        "output": "spec_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "spec is parseable and linked to objective/scope",
      "inline_ap": {
        "ap_id": "inline-ap:spec-authoring-contract:p1",
        "skill_id": "meta.arch.spec-writer",
        "actor": "architect",
        "lifecycle": "ephemeral",
        "pierce_allowed": true,
        "pierce_rule": "allow_when_parent_actor_equals_ap_actor"
      },
      "phase_purpose": "产出可执行规格契约",
      "input_context_ref": "objective_ref + scope_baseline_ref",
      "done_definition": "必须产出 spec_ref，并满足“规格可解析并关联 objective/scope”",
      "handoff_note": "将 spec_ref 交接给 initiator"
