{
  "process_id": "spec-authoring-contract",
  "version": "0.1.0",
  "process_level": "P5",
  "parent_process_id": null,
  "composed_processes": [],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m3-spec-authoring-contract",
  "owner": "bpm",
  "priority": "P1",
  "input_contract": {
    "format": "json",
