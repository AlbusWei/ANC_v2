{
  "process_id": "quality-gate-evaluation",
  "version": "0.1.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [
    "hold-governance"
  ],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m1-unified-quality-gate",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "preparation_bundle_ref",
      "actual_output_refs",
      "profile_set"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "gate_decision",
      "evidence_ref",
      "final_gate_verdict_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "run-objective-evaluation",
      "actor": "qa",
      "target_type": "skill",
      "target_id": "sys.qa.evaluation-runner",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-007-objective-evaluation.md#AP-007-Objective-Evaluation",
      "sipoc": {
        "supplier": "initiator",
        "input": "preparation_bundle_ref + actual_output_refs",
        "process": "run objective evaluation profiles",
        "output": "objective_eval_ref",
        "client": "p2"
      },
      "acceptance_criteria": "objective verdict is parseable and traceable"
    },
    {
      "phase_id": "p2",
      "name": "run-subjective-evaluation",
      "actor": "qa",
      "target_type": "skill",
      "target_id": "sys.qa.evaluation-runner",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-008-subjective-evaluation.md#AP-008-Subjective-Evaluation",
      "sipoc": {
        "supplier": "p1",
        "input": "preparation_bundle_ref + actual_output_refs + subjective_plan",
        "process": "run blind subjective evaluation by default",
        "output": "subjective_eval_ref",
        "client": "p3"
      },
      "acceptance_criteria": "subjective run records seed rounds and verdict"
    },
    {
      "phase_id": "p3",
      "name": "run-regression-evaluation",
      "actor": "qa",
      "target_type": "skill",
      "target_id": "sys.qa.regression-runner",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-009-regression-execution.md#AP-009-Regression-Execution",
      "sipoc": {
        "supplier": "p2",
        "input": "preparation_bundle_ref + profile_set + actual_output_refs",
        "process": "run cross module regression",
        "output": "regression_eval_ref",
        "client": "p4"
      },
      "acceptance_criteria": "regression report contains module level verdicts"
    },
    {
      "phase_id": "p4",
      "name": "aggregate-gate-decision",
      "actor": "qa",
      "target_type": "skill",
      "target_id": "sys.qa.verdict-normalizer",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-020-gate-decision-aggregation.md#AP-020-Gate-Decision-Aggregation",
      "sipoc": {
        "supplier": "p3",
        "input": "objective_eval_ref + subjective_eval_ref + regression_eval_ref",
        "process": "aggregate unified gate decision",
        "output": "gate_decision",
        "client": "initiator"
      },
      "acceptance_criteria": "gate decision follows unified verdict enum and P0 precedence"
    },
    {
      "phase_id": "p5",
      "name": "govern-hold",
      "actor": "bpm",
      "target_type": "subprocess",
      "target_id": "hold-governance",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/hold-governance-process.md#目标",
      "sipoc": {
        "supplier": "p4",
        "input": "hold_case_ref",
        "process": "route hold case into hold governance subprocess",
        "output": "hold_resolution_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "hold cases are resolved or escalated with evidence"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "hold"
    },
    {
      "from": "p4",
      "to": "end",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_attempts": 1
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason"
    ]
  }
}
