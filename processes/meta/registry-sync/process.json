{
  "process_id": "registry-sync",
  "version": "0.1.0",
  "process_level": "P6",
  "parent_process_id": null,
  "composed_processes": [],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m3-registry-sync-runtime",
  "owner": "hr",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "target_registry_ref",
      "registry_patch_plan_ref",
      "requested_transition_ref",
      "verify_scope",
      "evidence_ref"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "registry_sync_ref",
      "registry_verify_report_ref",
      "sync_decision",
      "reasons"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "verify-registry-and-sync",
      "actor": "hr",
      "target_type": "skill",
      "target_id": "sys.qa.registry-validator",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-011-registry-sync.md#ap-011-registry-sync",
      "sipoc": {
        "supplier": "initiator",
        "input": "registry patch and transition request",
        "process": "run registry verify and persist sync record",
        "output": "registry_sync_ref + registry_verify_report_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "registry verify result is explicit and auditable"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_attempts": 1
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason",
      "evidence_ref"
    ]
  }
}
