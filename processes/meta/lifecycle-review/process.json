{
  "process_id": "lifecycle-review",
  "version": "0.1.0",
  "process_level": "P4",
  "parent_process_id": null,
  "composed_processes": [],
  "lineage_policy": {
    "stack_depth_limit": 8,
    "context_isolation": "strict",
    "output_handoff_mode": "contract_only"
  },
  "objective_ref": "obj-m4-lifecycle-review-runtime",
  "owner": "hr",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": [
      "final_gate_verdict_ref",
      "target_asset_ref",
      "requested_transition"
    ]
  },
  "output_contract": {
    "format": "json",
    "required": [
      "lifecycle_transition_ref",
      "registry_sync_ref",
      "lifecycle_review_report_ref"
    ]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "validate-request",
      "actor": "hr",
      "target_type": "skill",
      "target_id": "system.ops.manual-task",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/lifecycle-review-process.md#阶段定义",
      "sipoc": {
        "supplier": "initiator",
        "input": "final_gate_verdict_ref + target_asset_ref + requested_transition",
        "process": "validate lifecycle review request shape and field completeness",
        "output": "validated_request_ref",
        "client": "p2"
      },
      "acceptance_criteria": "required fields are complete and references are reachable"
    },
    {
      "phase_id": "p2",
      "name": "check-prerequisites",
      "actor": "hr",
      "target_type": "skill",
      "target_id": "system.ops.manual-task",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/lifecycle-review-process.md#阶段定义",
      "sipoc": {
        "supplier": "p1",
        "input": "validated_request_ref + target_asset_ref + requested_transition",
        "process": "check current lifecycle status and transition preconditions",
        "output": "prerequisites_check_ref",
        "client": "p3"
      },
      "acceptance_criteria": "transition path is legal under five-state lifecycle rule"
    },
    {
      "phase_id": "p3",
      "name": "quality-gate",
      "actor": "hr",
      "target_type": "skill",
      "target_id": "system.ops.manual-task",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/quality-gate-evaluation-process.md#输出契约",
      "sipoc": {
        "supplier": "p2",
        "input": "final_gate_verdict_ref",
        "process": "verify gate verdict is pass before transition",
        "output": "quality_gate_check_ref",
        "client": "p4"
      },
      "acceptance_criteria": "quality gate verdict equals pass and evidence is traceable"
    },
    {
      "phase_id": "p4",
      "name": "execute-transition",
      "actor": "hr",
      "target_type": "skill",
      "target_id": "system.ops.manual-task",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-010-lifecycle-transition.md#ap-010-lifecycle-transition",
      "sipoc": {
        "supplier": "p3",
        "input": "target_asset_ref + from_status + requested_transition",
        "process": "record lifecycle transition after gate checks",
        "output": "lifecycle_transition_ref",
        "client": "p5"
      },
      "acceptance_criteria": "transition record includes from/to status, actor and evidence references"
    },
    {
      "phase_id": "p5",
      "name": "sync-registry",
      "actor": "hr",
      "target_type": "skill",
      "target_id": "sys.qa.registry-validator",
      "requires_spec": true,
      "spec_ref": "docs/design/processes/atomic/AP-011-registry-sync.md#ap-011-registry-sync",
      "sipoc": {
        "supplier": "p4",
        "input": "lifecycle_transition_ref",
        "process": "verify registry consistency and persist sync record",
        "output": "registry_sync_ref + lifecycle_review_report_ref",
        "client": "initiator"
      },
      "acceptance_criteria": "registry verification passes and sync evidence is persisted"
    }
  ],
  "control_flow": [
    {
      "from": "p1",
      "to": "p2",
      "on": "success"
    },
    {
      "from": "p2",
      "to": "p3",
      "on": "success"
    },
    {
      "from": "p3",
      "to": "p4",
      "on": "success"
    },
    {
      "from": "p4",
      "to": "p5",
      "on": "success"
    },
    {
      "from": "p5",
      "to": "end",
      "on": "success"
    }
  ],
  "fail_policy": {
    "mode": "fail_closed",
    "retry": {
      "max_attempts": 1
    },
    "escalation_chain": [
      "actor",
      "owner",
      "bpm",
      "admin",
      "human"
    ]
  },
  "evidence_policy": {
    "required_fields": [
      "timestamp",
      "phase_id",
      "actor",
      "input_ref",
      "output_ref",
      "decision",
      "reason"
    ]
  }
}
