{
  "process_id": "development-process",
  "version": "0.1.0",
  "objective_ref": "obj-phase0.5-development-process",
  "owner": "bpm",
  "priority": "P0",
  "input_contract": {
    "format": "json",
    "required": ["objective_ref", "input_payload", "target_skill_name"]
  },
  "output_contract": {
    "format": "json",
    "required": ["final_output", "evidence_refs", "verdict"]
  },
  "phases": [
    {
      "phase_id": "p1",
      "name": "clarify-objective-and-scope",
      "actor": "architect",
      "skill_or_process": "skill-creator",
      "sipoc": {
        "supplier": "initiator",
        "input": "input_payload",
        "process": "clarify objective, constraints and target skill scope",
        "output": "normalized_requirement",
        "client": "p2"
      },
      "acceptance_criteria": "objective, constraints and target skill are explicit"
    },
    {
      "phase_id": "p2",
      "name": "author-skill-asset",
      "actor": "architect",
      "skill_or_process": "skill-creator",
      "sipoc": {
        "supplier": "p1",
        "input": "normalized_requirement",
        "process": "author or update skill files",
        "output": "skill_asset",
        "client": "p3"
      },
      "acceptance_criteria": "skill asset exists with parseable frontmatter"
    },
    {
      "phase_id": "p3",
      "name": "design-and-run-tests",
      "actor": "qa",
      "skill_or_process": "skill-creator",
      "sipoc": {
        "supplier": "p2",
        "input": "skill_asset",
        "process": "design TEST.md and validate contracts",
        "output": "test_evidence",
        "client": "p4"
      },
      "acceptance_criteria": "test plan exists and evidence is traceable"
    },
    {
      "phase_id": "p4",
      "name": "sync-registry",
      "actor": "bpm",
      "skill_or_process": "skill-creator",
      "sipoc": {
        "supplier": "p3",
        "input": "test_evidence",
        "process": "update registry records for new/updated assets",
        "output": "registry_patch_and_verdict",
        "client": "initiator"
      },
      "acceptance_criteria": "registry fields align with asset frontmatter and paths"
    }
  ],
  "control": {
    "mode": "sequence",
    "retries": {
      "max_attempts": 1
    }
  },
  "failure_policy": {
    "mode": "fail_closed",
    "escalation_chain": ["actor", "owner", "bpm", "admin"]
  },
  "evidence_policy": {
    "required_fields": ["timestamp", "phase_id", "actor", "input_ref", "output_ref", "decision"]
  }
}
