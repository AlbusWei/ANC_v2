{
  "schema_version": "1.1.0",
  "registry": "agent_directory",
  "updated_at": "2026-02-21T18:00:00Z",
  "entry_contract": {
    "required": [
      "agent_id",
      "layer",
      "path",
      "default_model",
      "owner",
      "status",
      "permissions",
      "bindings"
    ],
    "properties": {
      "agent_id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "stable agent identifier"
      },
      "layer": {
        "type": "string",
        "enum": [
          "kernel",
          "control",
          "app"
        ],
        "description": "layer classification"
      },
      "path": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
        "description": "repo-relative agent workspace path"
      },
      "default_model": {
        "type": "string",
        "description": "default llm model"
      },
      "owner": {
        "type": "string",
        "description": "owner agent_id or human"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "review",
          "active",
          "deprecated",
          "retired"
        ],
        "description": "lifecycle status"
      },
      "permissions": {
        "type": "array",
        "items": {
          "type": "string"
        },
        "minItems": 1,
        "uniqueItems": true,
        "description": "permission scopes"
      },
      "bindings": {
        "type": "object",
        "required": [
          "channels",
          "channelsConfig"
        ],
        "properties": {
          "channels": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "uniqueItems": true,
            "description": "referenced channel names"
          },
          "channelsConfig": {
            "type": "object",
            "description": "channel-level agent config"
          }
        },
        "additionalProperties": false,
        "description": "openclaw channel bindings"
      }
    },
    "additionalProperties": false
  },
  "entries": [
