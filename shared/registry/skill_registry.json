{
  "schema_version": "1.1.0",
  "registry": "skill_registry",
  "updated_at": "2026-02-21T18:00:00Z",
  "entry_contract": {
    "required": [
      "skill_id",
      "name",
      "path",
      "layer",
      "owner",
      "version",
      "status",
      "agentskills",
      "openclaw",
      "tests"
    ],
    "properties": {
      "skill_id": {
        "type": "string",
        "pattern": "^[a-z0-9]+(\\.[a-z0-9-]+)+$",
        "description": "stable skill identifier"
      },
      "name": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "skill display name"
      },
      "path": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
        "description": "repo-relative SKILL.md path"
      },
      "layer": {
        "type": "string",
        "enum": [
          "meta",
          "system",
          "business"
        ],
        "description": "skill layer"
      },
      "owner": {
        "type": "string",
        "description": "owner agent_id"
      },
      "version": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
        "description": "semantic version"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "review",
          "active",
          "deprecated",
          "retired"
        ],
        "description": "lifecycle status"
      },
      "agentskills": {
        "type": "object",
        "required": [
          "name",
          "description",
          "license",
          "compatibility"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "frontmatter name"
          },
          "description": {
            "type": "string",
            "description": "frontmatter description"
          },
          "license": {
            "type": "string",
            "description": "frontmatter license"
          },
          "compatibility": {
            "type": "object",
            "required": [
              "openclaw",
              "agentskills"
            ],
            "properties": {
              "openclaw": {
                "type": "string",
                "description": "openclaw compatibility range"
              },
              "agentskills": {
                "type": "string",
                "description": "agentskills compatibility range"
              }
            },
            "additionalProperties": false,
            "description": "compatibility matrix"
          }
        },
        "additionalProperties": false,
        "description": "agent skills frontmatter snapshot"
      },
      "openclaw": {
        "type": "object",
        "required": [
          "projection_mode",
          "entry_key",
          "source",
          "install_strategy"
        ],
        "properties": {
          "projection_mode": {
            "type": "string",
            "enum": [
              "bundle",
              "pin",
              "off"
            ],
            "description": "projection strategy"
          },
          "entry_key": {
            "type": "string",
            "description": "stable OpenClaw entry key"
          },
          "source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
            "description": "OpenClaw source path"
          },
          "install_strategy": {
            "type": "string",
            "enum": [
              "lazy",
              "eager"
            ],
            "description": "OpenClaw install strategy"
          },
          "bundle_key": {
            "type": "string",
            "description": "bundle key when projection_mode=bundle"
          },
          "bundle_source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
            "description": "bundle source when projection_mode=bundle"
          },
          "allow_draft_projection": {
            "type": "boolean",
            "description": "allow draft assets in runtime projection"
          }
        },
        "additionalProperties": false,
        "description": "OpenClaw projection metadata"
      },
      "tests": {
        "type": "object",
        "required": [
          "test_doc",
          "methodology_ref"
        ],
        "properties": {
          "test_doc": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
            "description": "skill test doc path"
          },
          "methodology_ref": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))[A-Za-z0-9._/-]+$",
            "description": "test methodology reference"
          }
        },
        "additionalProperties": false,
        "description": "test references"
      }
    },
    "additionalProperties": false
  },
