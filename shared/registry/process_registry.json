  "entry_contract": {
    "required": [
      "process_id",
      "skill_name",
      "skill_path",
      "manifest_path",
      "objective_ref",
      "owner",
      "version",
      "status",
      "phase_count",
      "openclaw"
    ],
    "properties": {
      "process_id": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "stable process identifier"
      },
      "skill_name": {
        "type": "string",
        "pattern": "^[a-z0-9-]+$",
        "description": "process skill frontmatter name"
      },
      "skill_path": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
        "description": "repo-relative process SKILL.md path"
      },
      "manifest_path": {
        "type": "string",
        "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
        "description": "repo-relative process manifest path"
      },
      "objective_ref": {
        "type": "string",
        "description": "objective identifier"
      },
      "owner": {
        "type": "string",
        "description": "owner agent_id"
      },
      "version": {
        "type": "string",
        "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$",
        "description": "semantic version"
      },
      "status": {
        "type": "string",
        "enum": [
          "draft",
          "review",
          "active",
          "deprecated",
          "retired"
        ],
        "description": "lifecycle status"
      },
      "phase_count": {
        "type": "integer",
        "minimum": 1,
        "description": "declared phase count"
      },
      "openclaw": {
        "type": "object",
        "required": [
          "projection_mode",
          "entry_key",
          "source"
        ],
        "properties": {
          "projection_mode": {
            "type": "string",
            "enum": [
              "bundle",
              "pin",
              "off"
            ],
            "description": "projection strategy"
          },
          "entry_key": {
            "type": "string",
            "description": "stable OpenClaw entry key"
          },
          "source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
            "description": "repo-relative OpenClaw source path"
          },
          "bundle_key": {
            "type": "string",
            "description": "bundle key when projection_mode=bundle"
          },
          "bundle_source": {
            "type": "string",
            "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$)).+",
            "description": "repo-relative bundle source when projection_mode=bundle"
          },
          "allow_draft_projection": {
            "type": "boolean",
            "description": "allow draft assets in runtime projection"
          }
        },
        "additionalProperties": false,
        "description": "OpenClaw projection metadata"
      }
    },
    "additionalProperties": false
  },
